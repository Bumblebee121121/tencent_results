# 原始数据和大型映射
/data/
*.pkl

# Python 缓存
**/__pycache__/
*.py[cod]

# 编辑器及下载缓存
.vscode/
.cache/

# EDA 临时文件
artifacts/eda/metrics/.*.tmp

# 全量 item 聚合可能很大；GPT 通常只需汇总 CSV/JSON
artifacts/eda/tables/*.parquet

# Stage 3 generated parquet artifacts
artifacts/stage3/**/*.parquet
artifacts/stage3_debug/**/*.parquet

# Stage 4 generated feature stores are large; retain code and small JSON/CSV audits only
artifacts/stage4/**/*.npy
artifacts/stage4/**/*.parquet
artifacts/stage4_debug/**/*.npy
artifacts/stage4_debug/**/*.parquet

# Stage 5 generated model/index/table artifacts
artifacts/stage5/**/*.parquet
artifacts/stage5/**/*.npy
artifacts/stage5/**/*.pt
artifacts/stage5/**/*.index
artifacts/stage5_debug/**/*.parquet
artifacts/stage5_debug/**/*.npy
artifacts/stage5_debug/**/*.pt
artifacts/stage5_debug/**/*.index
artifacts/stage5_test_tmp/

# Stage 6 generated checkpoints, indexes, predictions and debug artifacts
artifacts/stage6/**/*.parquet
artifacts/stage6/**/*.npy
artifacts/stage6/**/*.pt
artifacts/stage6/**/*.index
artifacts/stage6_debug/
artifacts/stage6_test_tmp/
logs/stage6/
logs/stage6_debug/
