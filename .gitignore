# 原始数据和大型映射
/data/
*.pkl

# Python 缓存
**/__pycache__/
*.py[cod]

# 编辑器及下载缓存
.vscode/
.cache/

# EDA 临时文件
artifacts/eda/metrics/.*.tmp

# 全量 item 聚合可能很大；GPT 通常只需汇总 CSV/JSON
artifacts/eda/tables/*.parquet

# Stage 3 generated parquet artifacts
artifacts/stage3/**/*.parquet
artifacts/stage3_debug/**/*.parquet

# Stage 4 generated feature stores are large; retain code and small JSON/CSV audits only
artifacts/stage4/**/*.npy
artifacts/stage4/**/*.parquet
artifacts/stage4_debug/**/*.npy
artifacts/stage4_debug/**/*.parquet
